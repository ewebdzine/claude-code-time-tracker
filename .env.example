# --- Hosted (Vercel) deployment: magic-link auth + Blob-backed real data ---
# Leave ALL of these unset for local `npm run dev` — auth is bypassed and the
# dashboard reads your live ~/.claude directly.

# Long random string that signs magic links + session cookies.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Comma-separated addresses allowed to sign in.
ALLOWED_EMAILS=you@example.com

# Resend API key (https://resend.com) used to email the magic link.
RESEND_API_KEY=
# Optional "from" address. Defaults to Resend's sandbox sender, which delivers
# to the Resend account owner's own inbox — fine for a single-user dashboard.
# MAGIC_FROM=onboarding@resend.dev

# Set automatically when you create a Vercel Blob store in the project.
# Also needed locally by `npm run push-blob` to upload your report.
BLOB_READ_WRITE_TOKEN=

# Optional: override the base URL used to build magic links (else request origin).
# APP_URL=https://claude-code-time-tracker.vercel.app

# Optional: point at a non-default Claude data dir (used by scan + push-blob).
# CLAUDE_DIR=/home/you/.claude
